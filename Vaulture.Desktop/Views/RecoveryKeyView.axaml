<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             x:Class="Vaulture.Desktop.Views.RecoveryKeyView"
             x:DataType="vm:RecoveryKeyViewModel">

    <Grid>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="550">
            <StackPanel Spacing="20">
                <TextBlock Text="VAULT CREATED SUCCESSFULLY" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" LetterSpacing="2" />
                
                <TextBlock Text="Your vault is now encrypted. You must save both of these keys before proceeding. If you lose them, your data cannot be recovered." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                
                <!-- 1. Master Password -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <TextBlock Text="1. Your Master Password" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="This is your primary key. You will need to enter this every time you open the app to unlock your vault." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                            <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8,0,0,8" Padding="15">
                                <SelectableTextBlock Text="{Binding MasterPassword}" FontSize="18" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1" CommandParameter="{Binding MasterPassword}" Click="CopyKey_Click" CornerRadius="0,8,8,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,1,1" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="20,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 2. Emergency Recovery Key -->
                <Border Background="#10FF0000" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <TextBlock Text="2. Emergency Recovery Key" FontSize="16" FontWeight="Bold" Foreground="Red" />
                        <TextBlock Text="Print this out or write it on a piece of paper. This is the ONLY way to recover your vault if you forget your master password." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                            <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="Red" BorderThickness="1" CornerRadius="8,0,0,8" Padding="15">
                                <SelectableTextBlock Text="{Binding RecoveryKey}" FontSize="24" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red" />
                            </Border>
                            <Button Grid.Column="1" CommandParameter="{Binding RecoveryKey}" Click="CopyKey_Click" CornerRadius="0,8,8,0" Background="#33FF0000" Foreground="White" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="20,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14" Foreground="White" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Button Content="I have safely stored both my Password and Recovery Key" Command="{Binding ContinueToDashboardCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Padding="15" FontSize="16" FontWeight="Bold" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
