<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Vaulture.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <Grid ColumnDefinitions="250, *, 300" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <!-- LEFT SIDEBAR: Folders -->
        <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *">
                <!-- Header -->
                <Border Grid.Row="0" Padding="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📁" FontSize="20" />
                        <TextBlock Text="My Vault" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Folder TreeView -->
                <TreeView Grid.Row="1" ItemsSource="{Binding Folders}" Margin="10,0">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding SubFolders}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📁" FontSize="16" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- CENTER: Entry List -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Border Grid.Row="0" Padding="15" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Watermark="Search entries..." Classes="clearButton" />
                    <Button Grid.Column="1" Content="Add Entry" Command="{Binding AddDummyEntryCommand}" Classes="accent" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentEntries}" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto, *" Margin="5">
                            <TextBlock Grid.Column="0" Text="🔑" FontSize="24" Margin="0,0,15,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- RIGHT: Detail Panel -->
        <Border Grid.Column="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Border Padding="20">
                <StackPanel Spacing="15">
                    <!-- Lock Button -->
                    <Button Content="Lock Vault" Command="{Binding LockVaultCommand}" HorizontalAlignment="Right" />

                <TextBlock Text="Entry Details" FontWeight="SemiBold" FontSize="18" Margin="0,20,0,10" />
                
                <TextBlock Text="Select an entry to view its details." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
