<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Vaulture.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <UserControl.Styles>
        <Style Selector="Image.logo">
            <Style.Animations>
                <Animation Duration="0:0:1.5" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.2" />
                        <Setter Property="RotateTransform.Angle" Value="-45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="StackPanel.form">
            <Style.Animations>
                <Animation Duration="0:0:1" Delay="0:0:0.5" FillMode="Both" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Spacing="20">
            
            <Image Classes="logo" Source="avares://Vaulture.Desktop/Assets/vaulture-logo.png" Width="140" Height="140" Margin="0,0,0,10">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <RotateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <StackPanel Classes="form" Spacing="20">
                <TextBlock Text="Vaulture" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
                <!-- STEP 1: Google Drive Auth -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="15" IsVisible="{Binding IsNotGoogleAuthenticated}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="☁️" />
                            <TextBlock Text="Step 1: Link Cloud Backup" FontWeight="SemiBold" />
                        </StackPanel>
                        
                        <TextBlock Text="We highly recommend linking your Google Drive. Since your vault is completely offline and encrypted, linking your drive automatically syncs your encrypted database so you can recover your passwords if you lose this device." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                   
                        <Button Command="{Binding SignInWithGoogleCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto, *">
                                <Image Grid.Column="0" Source="avares://Vaulture.Desktop/Assets/google.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Sign in with Google Drive" HorizontalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- STEP 2: Master Password -->
                <StackPanel Spacing="20" IsVisible="{Binding IsGoogleAuthenticated}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="🔐" />
                        <TextBlock Text="Step 2: Create Master Password" FontWeight="SemiBold" IsVisible="{Binding IsFirstTimeSetup}" />
                        <TextBlock Text="Step 2: Unlock Local Vault" FontWeight="SemiBold" IsVisible="{Binding IsNotFirstTimeSetup}" />
                    </StackPanel>
                    
                    <TextBlock IsVisible="{Binding IsFirstTimeSetup}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Your Master Password is the only key to your vault. It encrypts all your data locally on your device. We cannot recover it for you if you lose it, so make sure it is strong and memorable!" />
                    
                    <TextBlock Text="Master Password" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding MasterPassword}" PasswordChar="•" PlaceholderText="Enter your master password" Classes="revealPasswordButton" />
                        <Button Grid.Column="1" Command="{Binding GenerateMasterPasswordCommand}" Content="Generate Password" Cursor="Hand" Margin="10,0,0,0" IsVisible="{Binding IsFirstTimeSetup}" />
                    </Grid>
                    
                    <Button Content="Create Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" IsVisible="{Binding IsFirstTimeSetup}" />
                    <Button Content="Unlock Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" IsVisible="{Binding IsNotFirstTimeSetup}" />
                </StackPanel>
                
            </StackPanel>
        </StackPanel>
        
        <!-- Logged In Profile Badge (Click to Sign Out) -->
        <Button Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="20" Padding="10,5" IsVisible="{Binding IsGoogleAuthenticated}" ToolTip.Tip="Click to sign out of Google">
            <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="10" MinWidth="150">
                        <TextBlock Text="Sign out of Google?" FontWeight="SemiBold" />
                        <Button Content="Sign Out" Command="{Binding SignOutCommand}" Classes="accent" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border CornerRadius="15" Width="30" Height="30" ClipToBounds="True">
                    <Image Source="{Binding UserAvatar}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding UserEmail}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
