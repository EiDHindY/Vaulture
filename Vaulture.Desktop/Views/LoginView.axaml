<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Vaulture.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <UserControl.Styles>
        <Style Selector="Image.logo">
            <Style.Animations>
                <Animation Duration="0:0:1.5" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.2" />
                        <Setter Property="RotateTransform.Angle" Value="-45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="StackPanel.form">
            <Style.Animations>
                <Animation Duration="0:0:1" Delay="0:0:0.5" FillMode="Both" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Spacing="20">
            
            <Image Classes="logo" Source="avares://Vaulture.Desktop/Assets/vaulture-logo.png" Width="140" Height="140" Margin="0,0,0,10">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <RotateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <StackPanel Classes="form" Spacing="20">
                <TextBlock Text="Vaulture" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
                <!-- NEW VAULT SETUP UI -->
                <StackPanel Spacing="20" IsVisible="{Binding IsFirstTimeSetup}">
                    
                    <!-- Warning Card -->
                    <Border Background="#10FF0000" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Crucial Security Warning" FontSize="16" FontWeight="Bold" Foreground="Red" />
                            <TextBlock Text="Your Master Password mathematically encrypts your local database. Vaulture does not know it, and we cannot reset it. If you forget your Master Password, your data is permanently gone forever." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Password Input -->
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="Set Master Password" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding MasterPassword}" PasswordChar="•" PlaceholderText="Create a highly secure password" Classes="revealPasswordButton" />
                            <Button Grid.Column="1" Command="{Binding GenerateMasterPasswordCommand}" Content="Generate Strong Password" Cursor="Hand" Margin="10,0,0,0" Classes="accent" />
                        </Grid>
                        <Button Content="Create Encrypted Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" Margin="0,10,0,0" Padding="15" FontSize="16" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- UNLOCK EXISTING VAULT UI -->
                <StackPanel Spacing="20" IsVisible="{Binding IsNotFirstTimeSetup}">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Welcome Back" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter your Master Password to decrypt and unlock your local vault." TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            
                            <TextBox Text="{Binding MasterPassword}" PasswordChar="•" PlaceholderText="Master Password" Classes="revealPasswordButton" Margin="0,10" />
                            
                            <Button Content="Unlock Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" Padding="15" FontSize="16" FontWeight="Bold" />
                            
                            <Button Content="Forgot Password? (Recover or Reset)" Command="{Binding ShowForgotPasswordCommand}" Cursor="Hand" HorizontalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FORGOT PASSWORD UI -->
                <StackPanel Spacing="20" IsVisible="{Binding IsForgotPasswordVisible}">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Vault Recovery" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter your 16-character Emergency Recovery Key to decrypt your Master Password." TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            
                            <TextBox Text="{Binding RecoveryKeyInput}" PlaceholderText="XXXX-XXXX-XXXX-XXXX" FontFamily="Consolas" HorizontalContentAlignment="Center" Margin="0,10" />
                            
                            <Button Content="Recover Master Password" Command="{Binding RecoverVaultCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" Padding="15" FontSize="16" FontWeight="Bold" />
                            
                            <Button Content="Cancel" Command="{Binding HideForgotPasswordCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#10FF0000" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Lost your recovery key?" FontWeight="Bold" Foreground="Red" />
                            <TextBlock Text="If you lost both your password and your recovery key, you are permanently locked out. The only option is to delete your vault entirely and start from scratch." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            
                            <Button Content="Delete Vault &amp; Factory Reset" Command="{Binding FactoryResetCommand}" Cursor="Hand" HorizontalAlignment="Center" Background="#33FF0000" Foreground="Red" FontWeight="Bold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RECOVERY SUCCESS UI -->
                <StackPanel Spacing="20" IsVisible="{Binding IsRecoverySuccessVisible}">
                    <TextBlock Text="VAULT RECOVERED SUCCESSFULLY" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" LetterSpacing="2" />
                    
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="25">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Your Master Password has been decrypted." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Please copy and save your Master Password now. You will need it to unlock your vault." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            
                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8,0,0,8" Padding="15">
                                    <SelectableTextBlock Text="{Binding MasterPassword}" FontSize="18" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="1" CommandParameter="{Binding MasterPassword}" Click="CopyKey_Click" CornerRadius="0,8,8,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,1,1" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="20,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="14" Height="14" />
                                        <TextBlock Text="Copy" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="I have safely stored my Master Password" Command="{Binding ReturnToLoginFromRecoveryCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Padding="15" FontSize="16" FontWeight="Bold" Margin="0,10,0,0" />
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
