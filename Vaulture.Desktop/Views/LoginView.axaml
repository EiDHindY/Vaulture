<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Vaulture.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <UserControl.Styles>
        <Style Selector="Image.logo">
            <Style.Animations>
                <Animation Duration="0:0:1.5" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.2" />
                        <Setter Property="RotateTransform.Angle" Value="-45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="StackPanel.form">
            <Style.Animations>
                <Animation Duration="0:0:1" Delay="0:0:0.5" FillMode="Both" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Spacing="20">
            
            <Image Classes="logo" Source="avares://Vaulture.Desktop/Assets/vaulture-logo.png" Width="140" Height="140" Margin="0,0,0,10">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <RotateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <StackPanel Classes="form" Spacing="20">
                <TextBlock Text="Vaulture" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5" />
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
                <!-- Master Password -->
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="🔐" />
                        <TextBlock Text="Create Master Password" FontWeight="SemiBold" IsVisible="{Binding IsFirstTimeSetup}" />
                        <TextBlock Text="Unlock Local Vault" FontWeight="SemiBold" IsVisible="{Binding IsNotFirstTimeSetup}" />
                    </StackPanel>
                    
                    <TextBlock IsVisible="{Binding IsFirstTimeSetup}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Your Master Password is the only key to your vault. It encrypts all your data locally on your device. We cannot recover it for you if you lose it, so make sure it is strong and memorable!" />
                    
                    <TextBlock Text="Master Password" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding MasterPassword}" PasswordChar="•" PlaceholderText="Enter your master password" Classes="revealPasswordButton" />
                        <Button Grid.Column="1" Command="{Binding GenerateMasterPasswordCommand}" Content="Generate Password" Cursor="Hand" Margin="10,0,0,0" IsVisible="{Binding IsFirstTimeSetup}" />
                    </Grid>
                    
                    <Button Content="Create Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" IsVisible="{Binding IsFirstTimeSetup}" />
                    <Button Content="Unlock Vault" Command="{Binding LoginCommand}" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" IsVisible="{Binding IsNotFirstTimeSetup}" />
                </StackPanel>
                
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
