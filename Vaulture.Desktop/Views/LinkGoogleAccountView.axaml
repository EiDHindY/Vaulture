<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vaulture.Desktop.ViewModels"
             x:Class="Vaulture.Desktop.Views.LinkGoogleAccountView"
             x:DataType="vm:LinkGoogleAccountViewModel">

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <StackPanel Spacing="20">
                <TextBlock Text="LINK GOOGLE ACCOUNT" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" LetterSpacing="2" />
                
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="30">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Get Security Alerts &amp; Cloud Backups" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        
                        <TextBlock Text="Vaulture is an offline-first app, but you can link your Google Account to enable two powerful features:" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Email Security Alerts" FontWeight="Bold" />
                                <TextBlock Text="Get notified via Gmail (and mobile push) whenever your vault is unlocked or your password is changed." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" Data="M7.71,15.33V15.33L9.57,18.57L14.04,10.87H21.5L19.64,7.62H12.18M11.23,12.5L7.5,19H15L18.73,12.5M6.78,16.92L2.3,9.12H9.77L14.24,16.92" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Google Drive Sync" FontWeight="Bold" />
                                <TextBlock Text="Securely back up your encrypted vault database to your personal Google Drive." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        
                        <Button Content="Link Google Account" Command="{Binding LinkGoogleAccountCommand}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Padding="15" FontSize="16" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
